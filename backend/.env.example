# Template for the five backend .env files. Copy the relevant block into
# backend/<service>/.env — each service reads its own file.
#
# NEW in the security remediation:
#   INTERNAL_API_SECRET   required by ALL FIVE services (services now refuse to
#                         boot without it). Must be identical everywhere and at
#                         least 32 chars. Generate with:
#                           node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   COOKIE_SECURE         auth only. Defaults to ON. Set to "false" ONLY for
#                         local http development.
#   COOKIE_SAMESITE       auth only. Defaults to "lax".
#   REDIS_URL             now also required by the chat service.


# ─── backend/gateway/.env ─────────────────────────────────────────────────────
PORT=8000
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002
AGENT_SERVICE=http://localhost:8003
BILLING_SERVICE=http://localhost:8004
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
INTERNAL_API_SECRET=


# ─── backend/services/auth/.env ───────────────────────────────────────────────
PORT=8001
MONGODB_URI=
REDIS_URL=redis://localhost:6379
INTERNAL_API_SECRET=
# Set to false only over plaintext http on localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# ─── backend/services/chat/.env ───────────────────────────────────────────────
PORT=8002
MONGODB_URI=
REDIS_URL=redis://localhost:6379
INTERNAL_API_SECRET=


# ─── backend/services/agent/.env ──────────────────────────────────────────────
PORT=8003
MONGODB_URI=
REDIS_URL=redis://localhost:6379
INTERNAL_API_SECRET=
CHAT_SERVICE=http://localhost:8002
AUTH_SERVICE=http://localhost:8001
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=
HUGGINGFACEHUB_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=


# ─── backend/services/billing/.env ────────────────────────────────────────────
PORT=8004
MONGODB_URI=
AUTH_SERVICE=http://localhost:8001
INTERNAL_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
